{
  "name": "google-workspace-mcp",
  "version": "26.06.24",
  "description": "The template helps you build apps with Astro, Tailwind CSS, and shadcn/ui.",
  "license": "MIT",
  "author": {
    "name": "126colby",
    "url": "https://github.com/126colby"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmbish04/core-template-cfw-assets-astro-shadcn.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "pnpm run build && cp .assetsignore dist/.assetsignore && npx wrangler preview",
    "start": "astro dev",
    "test": "vitest run",
    "typecheck": "node --stack-size=8000 node_modules/typescript/lib/tsc.js --noEmit",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "migrate:local": "pnpm run db:generate && npx wrangler d1 migrations apply DB --local",
    "migrate:remote": "pnpm run db:generate && npx wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm run build && cp .assetsignore dist/.assetsignore && pnpm run migrate:remote && npx wrangler deploy",
    "deploy:dev": "CLOUDFLARE_ENV=dev pnpm run build && cp .assetsignore dist/.assetsignore && npx wrangler d1 migrations apply DB --remote --env dev && npx wrangler deploy --env dev",
    "deploy:dev:dry-run": "CLOUDFLARE_ENV=dev pnpm run build && cp .assetsignore dist/.assetsignore && npx wrangler deploy --env dev --dry-run",
    "deploy:preview": "pnpm run build && cp .assetsignore dist/.assetsignore && npx wrangler versions upload",
    "cf-typegen": "wrangler types",
    "deps:lockfile": "corepack pnpm install --no-frozen-lockfile && wrangler types",
    "deps:update": "corepack pnpm update --latest && corepack pnpm install --no-frozen-lockfile && wrangler types",
    "secrets": "node scripts/create-worker-secrets.mjs",
    "secrets:account": "node scripts/create-account-secrets.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.176",
    "@assistant-ui/react": "^0.12.28",
    "@assistant-ui/react-ai-sdk": "^1.3.21",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "@base-ui/react": "^1.4.1",
    "@cloudflare/ai-chat": "0.7.1",
    "@cloudflare/workers-types": "^4.20260502.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/swagger-ui": "^0.6.1",
