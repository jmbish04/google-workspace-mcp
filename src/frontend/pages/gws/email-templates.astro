---
/**
 * `/gws/email-templates` — the Gmail-safe email-template marketplace. Thin Astro
 * shell mounting the <EmailTemplates> island (client:load), which lists built-in
 * + user templates (each previewed in a sandboxed iframe) and adds new ones.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { EmailTemplates } from "@/components/email-templates";
---

<BaseLayout
  title="Email Templates"
  description="A marketplace of Gmail-safe, inline-styled HTML email templates — built-in best-practice starters plus your own."
>
  <div class="container mx-auto max-w-5xl px-4 py-16">
    <section class="mb-8 space-y-4">
      <h1 class="text-balance text-4xl font-bold tracking-tight">Email Templates</h1>
      <p class="max-w-2xl text-base text-muted-foreground">
        Gmail-safe, inline-styled HTML templates the model can use as a solid core — built-in
        best-practice starters plus your own. HTML is sanitized and CSS-inlined on save.
      </p>
    </section>

    <EmailTemplates client:load />
  </div>
</BaseLayout>
