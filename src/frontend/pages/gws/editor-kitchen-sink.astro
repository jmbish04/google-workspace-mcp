---
/**
 * `/gws/editor-kitchen-sink` — kitchen sink mounting all five ReUI Tiptap rich-text-editor
 * blocks + sheet-10.
 *
 * HARD RULE: Every editor island mounts `client:only="react"` — NOT `client:load`.
 * Tiptap and Yjs are browser-only; server rendering them fails with a null-dispatcher
 * `useMemo` error.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { EditorKitchenSink } from "@/components/editor-kitchen-sink";
---

<BaseLayout
  title="Editor Kitchen Sink"
  description="All five ReUI Tiptap rich-text-editor blocks plus sheet-10 AI assistant sheet."
>
  <EditorKitchenSink client:only="react" />
</BaseLayout>
