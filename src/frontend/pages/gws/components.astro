---
/**
 * `/gws/components` — showcase of the building blocks the agent can render into
 * Google Docs / Slides / Sheets: code blocks, styled tables, document heros,
 * tables of contents, page layouts, slide layouts, and sheet components (banded
 * ranges, gantt). Each is a LIVE HTML preview of the produced artifact. The
 * closing section lists the real batchUpdate `RECIPES` (imported from the backend
 * catalog that `docs_schema` / `GET /api/schema/:surface` expose).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { RECIPES, type SchemaSurface } from "@/backend/docs/schema";

const surfaces: SchemaSurface[] = ["docs", "slides", "sheets", "forms"];
// Gantt demo rows: [label, start%, width%].
const gantt: [string, number, number][] = [
  ["Discovery", 0, 20],
  ["Design", 15, 25],
  ["Build", 35, 40],
  ["QA", 68, 18],
  ["Launch", 86, 12],
];
---

<BaseLayout
  title="Components"
  description="The building blocks the agent renders into Docs, Slides, and Sheets — with live previews."
>
  <div class="container mx-auto max-w-6xl px-4 py-16">
    <section class="mb-10 space-y-4">
      <h1 class="text-balance text-4xl font-bold tracking-tight">Components</h1>
      <p class="max-w-2xl text-base text-muted-foreground">
        Reusable building blocks the agent composes into Google Docs, Slides, and Sheets. Each card
        is a live preview of what gets produced. Generate them via the factory tools
        (<code class="text-primary">table_factory</code>, <code class="text-primary">code_block_factory</code>,
        <code class="text-primary">slides_create_from_markdown</code>, …) inside <code class="text-primary">code_mode_run</code>.
      </p>
    </section>

    {/* ---- DOCS ---- */}
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Docs</h2>
    <div class="mb-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
      {/* Code block */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Code block</div>
        <div class="p-4">
          <div style="background:#0d1117;border-radius:8px;overflow:hidden;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;">
            <div style="display:flex;gap:6px;padding:8px 12px;border-bottom:1px solid #21262d;">
              <span style="width:11px;height:11px;border-radius:50%;background:#ff5f56;"></span>
              <span style="width:11px;height:11px;border-radius:50%;background:#ffbd2e;"></span>
              <span style="width:11px;height:11px;border-radius:50%;background:#27c93f;"></span>
              <span style="margin-left:8px;color:#8b949e;">export.ts</span>
            </div>
            <pre style="margin:0;padding:12px 14px;color:#c9d1d9;line-height:1.6;"><span style="color:#ff7b72;">export</span> <span style="color:#ff7b72;">async</span> <span style="color:#d2a8ff;">function</span> <span style="color:#d2a8ff;">run</span>() {'{'}
  <span style="color:#ff7b72;">const</span> r = <span style="color:#ff7b72;">await</span> tools.<span style="color:#79c0ff;">gmail_send</span>({'{'} to {'}'});
  <span style="color:#ff7b72;">return</span> r.id;
{'}'}</pre>
          </div>
        </div>
      </div>

      {/* Styled table */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Styled table (banded + header)</div>
        <div class="p-4">
          <table style="width:100%;border-collapse:collapse;font-size:13px;color:#26303b;background:#fff;border-radius:8px;overflow:hidden;">
            <thead><tr style="background:#1f4f78;color:#fff;text-align:left;">
              <th style="padding:8px 12px;">Item</th><th style="padding:8px 12px;">Qty</th><th style="padding:8px 12px;">Total</th>
            </tr></thead>
            <tbody>
              <tr style="background:#fff;"><td style="padding:8px 12px;">Widget</td><td style="padding:8px 12px;">3</td><td style="padding:8px 12px;">$45</td></tr>
              <tr style="background:#f2f6fb;"><td style="padding:8px 12px;">Gadget</td><td style="padding:8px 12px;">1</td><td style="padding:8px 12px;">$20</td></tr>
              <tr style="background:#fff;"><td style="padding:8px 12px;">Sprocket</td><td style="padding:8px 12px;">5</td><td style="padding:8px 12px;">$75</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      {/* Document hero */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Document hero / cover</div>
        <div class="p-4">
          <div style="border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;">
            <div style="height:96px;background:linear-gradient(120deg,#0f3a5f,#1a73e8);"></div>
            <div style="background:#fff;padding:16px 18px;">
              <div style="font-family:Georgia,serif;font-size:22px;font-weight:700;color:#0f172a;">Q3 Field Report</div>
              <div style="color:#64748b;font-size:13px;margin-top:4px;">Prepared by the Workspace agent · Aug 2026</div>
            </div>
          </div>
        </div>
      </div>

      {/* Table of contents */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Table of contents</div>
        <div class="p-4">
          <div style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:14px 18px;color:#26303b;font-size:13px;">
            <div style="font-weight:700;margin-bottom:8px;">Contents</div>
            {["1. Summary", "2. Findings", "3. Recommendations", "4. Appendix"].map((line, i) => (
              <div style={`display:flex;justify-content:space-between;padding:3px 0;${i ? "border-top:1px dotted #e5e7eb;" : ""}`}>
                <span>{line}</span><span style="color:#94a3b8;">{(i + 1) * 3}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Page layout with image */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40 lg:col-span-2">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Page layout — text + image</div>
        <div class="p-4">
          <div style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:18px 20px;display:grid;grid-template-columns:1.5fr 1fr;gap:18px;color:#26303b;">
            <div>
              <div style="font-size:16px;font-weight:700;color:#0f172a;">Section heading</div>
              <p style="font-size:13px;line-height:1.6;margin-top:6px;">A two-column layout pairs body copy with a supporting figure. The agent places the image inline, sizes it to the column, and keeps the caption with it.</p>
              <p style="font-size:13px;line-height:1.6;margin-top:8px;">Text wraps naturally; headings keep-with-next so they never orphan at a page break.</p>
            </div>
            <div>
              <div style="height:120px;border-radius:8px;background:linear-gradient(135deg,#e0e7ff,#c7d2fe);border:1px solid #e5e7eb;"></div>
              <div style="font-size:11px;color:#94a3b8;margin-top:5px;">Figure 1 — caption</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* ---- SLIDES ---- */}
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Slides — layouts</h2>
    <div class="mb-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { label: "Title slide", body: `<div style="height:100%;display:flex;flex-direction:column;justify-content:center;padding:0 8%;"><div style="font-size:20px;font-weight:800;color:#0f172a;">Presentation Title</div><div style="font-size:12px;color:#64748b;margin-top:6px;">Subtitle · Author</div></div>` },
        { label: "Title & body", body: `<div style="padding:14px 16px;"><div style="font-size:14px;font-weight:700;color:#0f172a;">Agenda</div><ul style="margin:8px 0 0 16px;color:#334155;font-size:11px;line-height:1.7;"><li>First point</li><li>Second point</li><li>Third point</li></ul></div>` },
        { label: "Two content", body: `<div style="padding:14px 16px;"><div style="font-size:14px;font-weight:700;color:#0f172a;">Comparison</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px;"><div style="background:#eef2ff;border-radius:6px;padding:8px;font-size:10px;color:#3730a3;">Option A</div><div style="background:#ecfdf5;border-radius:6px;padding:8px;font-size:10px;color:#065f46;">Option B</div></div></div>` },
        { label: "Section header", body: `<div style="height:100%;display:flex;align-items:center;padding:0 8%;background:#0f3a5f;"><div style="font-size:18px;font-weight:800;color:#fff;">02 · Findings</div></div>` },
        { label: "Big number", body: `<div style="height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;"><div style="font-size:34px;font-weight:800;color:#1a73e8;">87%</div><div style="font-size:11px;color:#64748b;">retention</div></div>` },
        { label: "Image + caption", body: `<div style="padding:12px;"><div style="height:70px;border-radius:6px;background:linear-gradient(135deg,#fde68a,#fca5a5);"></div><div style="font-size:11px;color:#475569;margin-top:6px;">Photo caption goes here</div></div>` },
      ].map((s) => (
        <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
          <div class="border-b border-border/40 px-4 py-2 text-xs font-medium">{s.label}</div>
          <div class="p-3">
            <div style="aspect-ratio:16/9;background:#fff;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden;" set:html={s.body}></div>
          </div>
        </div>
      ))}
    </div>

    {/* ---- SHEETS ---- */}
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Sheets</h2>
    <div class="mb-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
      {/* Gantt */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Gantt chart</div>
        <div class="p-4">
          <div style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:14px 16px;">
            {gantt.map(([label, start, width]) => (
              <div style="display:flex;align-items:center;gap:10px;margin:6px 0;">
                <span style="width:72px;font-size:11px;color:#475569;">{label}</span>
                <div style="flex:1;height:14px;background:#f1f5f9;border-radius:4px;position:relative;">
                  <span style={`position:absolute;left:${start}%;width:${width}%;top:0;bottom:0;background:#1a73e8;border-radius:4px;`}></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* KPI / banded */}
      <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
        <div class="border-b border-border/40 px-4 py-2.5 text-sm font-medium">Banded range + totals</div>
        <div class="p-4">
          <table style="width:100%;border-collapse:collapse;font-size:12.5px;color:#26303b;background:#fff;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;">
            <thead><tr style="background:#0f9d58;color:#fff;"><th style="padding:7px 12px;text-align:left;">Region</th><th style="padding:7px 12px;text-align:right;">Revenue</th></tr></thead>
            <tbody>
              <tr><td style="padding:7px 12px;">West</td><td style="padding:7px 12px;text-align:right;">$12,400</td></tr>
              <tr style="background:#eafaf1;"><td style="padding:7px 12px;">East</td><td style="padding:7px 12px;text-align:right;">$9,850</td></tr>
              <tr><td style="padding:7px 12px;">Central</td><td style="padding:7px 12px;text-align:right;">$7,300</td></tr>
              <tr style="border-top:2px solid #0f172a;font-weight:700;"><td style="padding:7px 12px;">Total</td><td style="padding:7px 12px;text-align:right;">$29,550</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    {/* ---- RECIPES (real backend catalog) ---- */}
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground">batchUpdate recipes</h2>
    <p class="mb-4 max-w-2xl text-sm text-muted-foreground">
      Curated, correct request patterns per surface (from the backend catalog <code class="text-primary">docs_schema</code> serves).
    </p>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {surfaces.filter((s) => RECIPES[s].length > 0).map((s) => (
        <div class="overflow-hidden rounded-xl bg-card ring-1 ring-border/40">
          <div class="flex items-center justify-between border-b border-border/40 px-4 py-2.5">
            <span class="text-sm font-medium capitalize">{s}</span>
            <Badge variant="outline" class="font-mono text-[10px]">{RECIPES[s].length}</Badge>
          </div>
          <ul class="divide-y divide-border/40">
            {RECIPES[s].map((r) => (
              <li class="px-4 py-3">
                <div class="font-mono text-xs text-foreground">{r.name}</div>
                <div class="mt-0.5 text-xs text-muted-foreground">{r.description}</div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
