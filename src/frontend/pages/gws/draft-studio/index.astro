---
/**
 * `/gws/draft-studio` — the list of emails being drafted on the worker rather
 * than in Gmail. Thin Astro shell around the `<DraftList>` island.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AuthGate } from "@/components/gsuite-agents/AuthGate";
import { DraftList } from "@/components/draft-studio";
---

<BaseLayout
  title="Draft Studio"
  description="Emails drafted and revised on this worker — numbered revisions, diffs, inline comments and live agent updates — before anything reaches Gmail."
>
  <AuthGate authed={false} client:load />
  <div class="container mx-auto max-w-5xl px-4 py-16">
    <section class="mb-10 space-y-4">
      <h1 class="text-balance text-4xl font-bold tracking-tight">Draft Studio</h1>
      <p class="max-w-2xl text-base text-muted-foreground">
        Where an email gets worked on. Every change the agent makes is a numbered
        revision you can read, diff and comment on, and the page updates while you
        watch. Nothing reaches Gmail until you send it or ask for a Gmail draft.
      </p>
    </section>

    <DraftList client:load />
  </div>
</BaseLayout>
