---
/**
 * `/gws/draft-studio/[id]` — one email under revision.
 *
 * The island mounts `client:only="react"`: it embeds Tiptap/ProseMirror, which
 * is browser-only and throws during Astro SSR.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DraftStudio } from "@/components/draft-studio";

const { id } = Astro.params;
if (!id) return Astro.redirect("/gws/draft-studio");
---

<BaseLayout
  title="Draft Studio"
  description="Read, diff, edit and comment on an email draft, then send it or hand it to Gmail."
>
  <div class="container mx-auto max-w-6xl px-4 py-12">
    <a href="/gws/draft-studio" class="text-sm text-muted-foreground hover:text-foreground">← All drafts</a>
    <h1 class="mb-6 mt-2 text-balance text-3xl font-bold tracking-tight">Draft Studio</h1>
    <DraftStudio draftId={id} client:only="react" />
  </div>
</BaseLayout>
