---
/**
 * `/docs/scripts/<slug>` — a single script's generator page. Resolves the spec
 * from the registry (SSR) and mounts the ScriptStudio island, which builds the
 * cURL / Python / TypeScript / Apps Script snippets client-side.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { ScriptStudio } from "@/components/scripts/ScriptStudio";
import { getScript } from "@/lib/scripts/registry";

const { slug } = Astro.params;
const spec = slug ? getScript(slug) : undefined;

if (!spec) {
  return Astro.redirect("/docs/scripts");
}
---

<BaseLayout title={spec.title} description={spec.summary}>
  <div class="container mx-auto max-w-4xl px-4 py-12">
    <a href="/docs/scripts" class="text-sm text-muted-foreground hover:text-foreground">← All scripts</a>

    <header class="mt-4 mb-8">
      <div class="mb-3 flex items-center gap-3">
        <span class="text-3xl">{spec.emoji}</span>
        <h1 class="text-3xl font-bold tracking-tight">{spec.title}</h1>
        <Badge variant="outline" class="text-[11px]">{spec.tag}</Badge>
      </div>
      <p class="max-w-3xl text-base text-muted-foreground">{spec.summary}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
        <span class="rounded bg-muted px-2 py-1 font-mono">POST /api/tools/{spec.tool}</span>
        <a href={`/api/tools/${spec.tool}`} class="text-primary hover:underline">schema</a>
        <span class="text-muted-foreground/50">·</span>
        <a href="/scalar" class="text-primary hover:underline">API reference</a>
      </div>
      {spec.resultNote ? <p class="mt-3 text-sm text-muted-foreground">{spec.resultNote}</p> : null}
    </header>

    <ScriptStudio spec={spec} client:load />
  </div>
</BaseLayout>
