#!/usr/bin/env bash
# pull-agents — sync the machine-wide agent briefings from jmbish04/colby-ecosystem
# into THIS repo, right-sized to what the repo actually is.
#
#   pull-agents                  detect, download, rewrite the managed block in AGENTS.md
#   pull-agents --list           print the file set and the evidence for each choice
#   pull-agents --dry-run        --list, plus what would be written, but write nothing
#   pull-agents --force-scripts  also overwrite a scripts/ file that is not ours
#   pull-agents install-hooks    post-merge + post-checkout hooks that re-run this script,
#                                plus a pre-commit that runs scripts/runner-guard
#
# WHY: the briefings live in $HOME, which is exactly where a cloud session, a CI runner
# or another checkout cannot see them. A repo with no copy is a repo where the rules
# silently do not apply, and "did not have the briefing" reads like "ignored it".
#
# WHAT IT TOUCHES
#   .agents/ecosystem/*.md   the synced briefings (overwritten every run)
#   .agents/ecosystem/pull-agents  a copy of this script, so hooks and CI run one version
#   .agents/ecosystem/MANAGED      every path this script owns, so the workflow can
#                            `git add` exactly those and nothing else
#   scripts/*.mjs            the default local scripts, right-sized the same way the
#                            briefings are. Only files carrying the managed banner are
#                            overwritten; an unmanaged file of the same name is left
#                            alone and named, unless --force-scripts
#   AGENTS.md                ONLY inside the delimited managed block. Everything outside
#                            it is left byte-for-byte alone, so the effective briefing is
#                            local AGENTS.md + colby-ecosystem's.
#
# AUTH: colby-ecosystem is PRIVATE, so a token is required.
#   local   gh auth login          (this script shells out to `gh api`)
#   CI      GH_TOKEN: ${{ secrets.COLBY_ECOSYSTEM_TOKEN }} — a PAT with read access to
#           jmbish04/colby-ecosystem. A workflow's own GITHUB_TOKEN cannot read another
#           repository; that failure is a 404, not a 403, so it is named explicitly below.
set -euo pipefail

SOURCE_REPO="${COLBY_ECOSYSTEM_SOURCE:-jmbish04/colby-ecosystem}"
SOURCE_REF="${COLBY_ECOSYSTEM_REF:-main}"
DEST_REL=".agents/ecosystem"
BEGIN_MARK="<!-- BEGIN colby-ecosystem: managed by pull-agents, do not edit inside this block -->"
END_MARK="<!-- END colby-ecosystem -->"

# Always loaded: the parent briefing, the control plane, and the git/PR rules. Every repo
# has PRs and every repo's work is tracked, so these are not conditional.
ALWAYS=(AGENTS.md AGENTS-maestro.md AGENTS-github.md)

die() { printf 'pull-agents: %s\n' "$*" >&2; exit 1; }
note() { [ -n "${QUIET:-}" ] || printf '%s\n' "$*"; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository"
cd "$ROOT"

# EITHER gh OR curl. This used to require gh outright, and that broke the sync
# on every ephemeral runner: the pve-135 box registers a fresh `pve-135-job-<id>`
# runner per job, and those do not ship the GitHub CLI even though the
# persistent `pve-135-colby-orchestrator` on the same box does. Same labels,
# different image - so the failure landed on whichever runner picked the job,
# which is why it looked intermittent. Measured on colby-maestro#281: the sync
# check died `gh: command not found` (exit 127) on job 119431901775.
#
# curl is the fallback rather than the primary because gh carries the local
# `gh auth login` credential, so a human running this on their own machine
# needs no token in the environment.
if command -v gh >/dev/null 2>&1; then
  FETCH_WITH=gh
elif command -v curl >/dev/null 2>&1; then
  [ -n "${GH_TOKEN:-}" ] || die "curl is available but GH_TOKEN is not set.
  ${SOURCE_REPO} is private, so an unauthenticated read gets a 404.
  In CI:    set GH_TOKEN (secrets.COLBY_ECOSYSTEM_TOKEN).
  Locally:  install gh and run \`gh auth login\`, or export GH_TOKEN."
  FETCH_WITH=curl
else
  die "neither gh nor curl is on PATH. Install one of them."
fi

fetch() {                              # fetch <path-in-source-repo> -> stdout
  local path="$1" out status
  if [ "$FETCH_WITH" = curl ]; then
    # `Accept: ...raw` returns the file's bytes directly, so there is no base64
    # hop to get wrong. --fail-with-body keeps the error body for the diagnosis
    # below instead of discarding it the way plain --fail does.
    if out="$(curl -sSL --fail-with-body \
                -H "Authorization: Bearer ${GH_TOKEN}" \
                -H "Accept: application/vnd.github.raw" \
                -H "X-GitHub-Api-Version: 2022-11-28" \
                "https://api.github.com/repos/${SOURCE_REPO}/contents/${path}?ref=${SOURCE_REF}" 2>&1)"; then
      printf '%s' "$out"
      return 0
    fi
    status="$out"
  elif out="$(gh api "repos/${SOURCE_REPO}/contents/${path}?ref=${SOURCE_REF}" --jq '.content' 2>&1)"; then
    printf '%s' "$out" | base64 -d
    return 0
  else
    status="$out"
  fi
  case "$status" in
    *"Not Found"*|*"404"*)
      die "cannot read ${SOURCE_REPO}/${path}.
  ${SOURCE_REPO} is private, so a token that cannot see it gets a 404, not a 403.
  In CI:    set GH_TOKEN to a PAT with read access (secrets.COLBY_ECOSYSTEM_TOKEN).
            The workflow's own GITHUB_TOKEN cannot read another repository.
  Locally:  gh auth status — and check the active account can see ${SOURCE_REPO}." ;;
    *) die "${FETCH_WITH} failed for ${path}: ${status}" ;;
  esac
}

# ---------------------------------------------------------------- change probe
# One request for the source ref's head commit SHA. The sync's per-file fan-out (5-8
# briefings + 3-6 scripts = 8-14 requests) runs only when this SHA has moved since the
# last sync, so an unchanged colby-ecosystem costs ONE request instead of 8-14.
#
# NOT a conditional (If-None-Match) request. A 304 does NOT cost zero primary quota on
# this API — measured 2026-11-18, a 304 decremented x-ratelimit-remaining exactly like a
# 200. So the gate compares the SHA the probe returns against the stored one; the probe
# itself is the one request we pay, unconditionally.
remote_head_sha() {                    # -> the 40-char head SHA of SOURCE_REPO@SOURCE_REF
  if [ "$FETCH_WITH" = curl ]; then
    curl -sSL --fail-with-body \
      -H "Authorization: Bearer ${GH_TOKEN}" \
      -H "Accept: application/vnd.github.sha" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      "https://api.github.com/repos/${SOURCE_REPO}/commits/${SOURCE_REF}"
  else
    gh api "repos/${SOURCE_REPO}/commits/${SOURCE_REF}" --jq '.sha'
  fi
}

# ---------------------------------------------------------------- what this repo is
# Evidence comes from the repo's own contents. Tracked files first: it is fast, and it
# never mistakes a vendored dependency for the project's own stack.
repo_paths() {
  local list
  list="$(git ls-files 2>/dev/null || true)"
  if [ -z "$list" ]; then
    list="$(find . -maxdepth 3 -type f -not -path './.git/*' -not -path './node_modules/*' 2>/dev/null | sed 's|^\./||')"
  fi
  printf '%s\n' "$list"
}

# grep a handful of small manifests, never the whole tree
manifest_text() {
  local f
  for f in package.json pyproject.toml requirements.txt wrangler.jsonc wrangler.toml wrangler.json; do
    [ -f "$f" ] && cat "$f"
  done
  true
}

SELECTED=""          # "file<TAB>reason" lines
select_file() {      # select_file <name> <reason>
  case "$SELECTED" in
    *"$1"$'\t'*) return 0 ;;
  esac
  SELECTED="${SELECTED}${1}"$'\t'"${2}"$'\n'
}

detect() {
  # Every grep here reads a here-string, never a pipe. `printf … | grep -q` lost a race
  # under `set -o pipefail`: GNU grep exits at its first match, the still-writing printf
  # dies of SIGPIPE, and the pipeline reports "no match". Measured 2026-11-11 on
  # colby-maestro PR #472 ("line 157: printf: write error: Broken pipe"): consecutive runs
  # on one tree deleted and re-added AGENTS-ai.md. scripts/test-pull-agents section 0b.
  local paths manifests f reason
  paths="$(repo_paths)"
  manifests="$(manifest_text)"

  for f in "${ALWAYS[@]}"; do select_file "$f" "always"; done

  if reason="$(grep -m1 -E '(^|/)(wrangler\.(jsonc|toml|json)|\.dev\.vars)$' <<< "$paths" || true)"; [ -n "$reason" ]; then
    select_file AGENTS-cloudflare-workers.md "$reason"
  fi
  if reason="$(grep -m1 -E '(^|/)(astro|next|vite|svelte|nuxt)\.config\.[cm]?[jt]s$|(^|/)tailwind\.config\.|(^|/)components\.json$|\.(tsx|jsx|astro|svelte|vue)$' <<< "$paths" || true)"; [ -n "$reason" ]; then
    select_file AGENTS-frontend.md "$reason"
  fi
  if reason="$(grep -m1 -E '(^|/)(pyproject\.toml|setup\.py|requirements[^/]*\.txt)$|\.py$' <<< "$paths" || true)"; [ -n "$reason" ]; then
    select_file AGENTS-python.md "$reason"
  fi
  if reason="$(grep -m1 -iE '(^|/)mcp([-_/.]|$)|mcp-server' <<< "$paths" || true)"; [ -n "$reason" ]; then
    select_file AGENTS-mcp.md "$reason"
  elif grep -qi 'modelcontextprotocol' <<< "$manifests"; then
    select_file AGENTS-mcp.md "modelcontextprotocol in a manifest"
  fi
  if grep -qE '@anthropic-ai|"openai"|"@ai-sdk|"ai":|anthropic|workers-ai|"ai"[[:space:]]*:[[:space:]]*\{' <<< "$manifests"; then
    select_file AGENTS-ai.md "an AI SDK or Workers AI binding in a manifest"
  fi
  if reason="$(grep -m1 -E '\.plist$|Launch(Agents|Daemons)' <<< "$paths" || true)"; [ -n "$reason" ]; then
    select_file AGENTS-macos.md "$reason"
  fi
  if reason="$(grep -m1 -i 'proxmox' <<< "$paths" || true)"; [ -n "$reason" ]; then
    select_file AGENTS-proxmox.md "$reason"
  fi

  # A repo may state what the detector cannot see. include/exclude are explicit and win.
  if [ -f .agents/ecosystem.json ]; then
    local inc exc
    inc="$(python3 -c 'import json,sys;d=json.load(open(".agents/ecosystem.json"));print("\n".join(d.get("include",[])))' 2>/dev/null || true)"
    exc="$(python3 -c 'import json,sys;d=json.load(open(".agents/ecosystem.json"));print("\n".join(d.get("exclude",[])))' 2>/dev/null || true)"
    while IFS= read -r f; do [ -n "$f" ] && select_file "$f" "include in .agents/ecosystem.json"; done <<< "$inc"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      SELECTED="$(printf '%s' "$SELECTED" | grep -v "^${f}"$'\t' || true)"$'\n'
    done <<< "$exc"
  fi
}

selected_files() { printf '%s' "$SELECTED" | awk -F'\t' 'NF{print $1}'; }

cmd_list() {
  detect
  printf '%s pulls these from %s@%s:\n\n' "$(basename "$ROOT")" "$SOURCE_REPO" "$SOURCE_REF"
  printf '%s' "$SELECTED" | awk -F'\t' 'NF{printf "  %-32s %s\n", $1, $2}'
}

# ---------------------------------------------------------------- write
render_block() {
  local f
  printf '%s\n' "$BEGIN_MARK"
  printf '## Machine-wide agent briefings (synced — do not edit here)\n\n'
  printf 'Pulled from `%s` by `.github/workflows/agents-sync.yml`, right-sized to this\n' "$SOURCE_REPO"
  printf "repo's stack. Read them before your first load-bearing change; where they and the\n"
  printf 'notes below this block disagree, they win. Edit them in `%s`, never here.\n\n' "$SOURCE_REPO"
  for f in $(selected_files); do printf '@%s/%s\n' "$DEST_REL" "$f"; done
  printf '\n'
  printf 'The scripts in `%s/` carrying a `%s` banner come from there too.\n' "$SCRIPTS_DIR" "$MANAGED_BANNER"
  printf 'Use them rather than writing another: `scripts/gh.mjs` is the GitHub entry point\n'
  printf 'and wraps the `gh-tools` CLI, which already solves the auth this machine trips on.\n'
  printf '`scripts/run.sh` is the verbose step runner: source it and put every step through\n'
  printf '`run`, so a script that fails on its first line says so instead of reading as a\n'
  printf 'success. `bash scripts/run.sh --self-check` proves its own checks can fail.\n\n'
  printf 'Work is tracked in **colby-maestro** (`https://colby-maestro.hacolby.workers.dev/mcp`,\n'
  printf 'bearer `$(tokens show WORKER_API_KEY --value-only)`) — never in this repo and never\n'
  printf 'in colby-ecosystem, which only stores config. Refresh this block with\n'
  printf '`%s/pull-agents`.\n\n' "$DEST_REL"
  printf 'Before a step these briefings do not plainly cover — a credential, a host, a database, a deploy, a backup — search **playbooks** on colby-maestro first, on a half-remembered fragment rather than a title, and say in the worklog what you found; write one when you had to work something out that nobody had written down (`%s/AGENTS.md`, "Write down what you worked out").\n' "$DEST_REL"
  printf '%s\n' "$END_MARK"
}

write_block() {
  local blockfile="$1" target="AGENTS.md" tmp
  if [ ! -f "$target" ]; then
    { cat "$blockfile"; printf '\n# %s\n\nRepo-local agent notes go below the block above.\n' "$(basename "$ROOT")"; } > "$target"
    note "created AGENTS.md with the managed block"
    return 0
  fi
  tmp="$(mktemp)"
  if grep -qF "$BEGIN_MARK" "$target"; then
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" -v bf="$blockfile" '
      index($0, b) { inb = 1; while ((getline l < bf) > 0) print l; close(bf); next }
      index($0, e) { inb = 0; next }
      !inb        { print }
    ' "$target" > "$tmp"
  else
    { cat "$blockfile"; printf '\n'; cat "$target"; } > "$tmp"
  fi
  if cmp -s "$tmp" "$target"; then rm -f "$tmp"; note "AGENTS.md block already current"; return 0; fi
  mv "$tmp" "$target"
  note "rewrote the managed block in AGENTS.md"
}

# ---------------------------------------------------------------- default scripts
# Agents keep hand-rolling a scripts/gh.mjs and re-solving GitHub auth badly, so the
# canonical one ships with the briefings. The set is right-sized the same way the
# chapters are: a Python repo has no use for the D1 migration fixer.
#
# MANAGED_BANNER is the contract. A file carrying it is ours and is overwritten; a file
# of the same name without it belongs to the repo and is left alone, because silently
# replacing someone's script is how this tool would become the thing people disable.
MANAGED_BANNER="colby-ecosystem: managed script"
SCRIPTS_DIR="scripts"

scripts_for_repo() {              # -> one script name per line
  # runner-guard goes everywhere too: every repo has workflows, and the pre-commit hook
  # below calls it to keep them on the failover router (AGENTS-github.md).
  # run.sh goes everywhere: it is shell, so no stack excludes it, and the failure
  # it prevents -- a script that errors on its first line and reads as a success --
  # is language-agnostic.
  printf 'gh.mjs\nrun.sh\nrunner-guard\n'
  case $'\n'"$(selected_files)"$'\n' in
    *$'\n'AGENTS-cloudflare-workers.md$'\n'*)
      printf 'fix-d1-migrations.mjs\n'
      # check-d1-not-inherited.mjs follows wrangler.jsonc for the same reason the D1
      # fixer does: only a Worker repo has a d1_databases block to get wrong. It was
      # hand-copied into four repos first (2026-11-02), which is how four copies of
      # one denylist start to disagree about which uuid is core-guardian's.
      printf 'check-d1-not-inherited.mjs\n'
      ;;
  esac
  case $'\n'"$(selected_files)"$'\n' in
    *$'\n'AGENTS-frontend.md$'\n'*) printf 'reui.mjs\nui-guard.mjs\n' ;;
  esac
  # ai-guard goes with the AI chapter, because the chapter's rule -- every inference
  # goes through core-guardian -- is the one nothing was checking. Measured 2026-11-02:
  # the router saw 0.0% of the account's Workers AI neurons for a whole billing cycle,
  # 94 of 272 wrangler configs declared a top-level `ai` binding, and 47 repos called
  # env.AI.run directly. A rule in a briefing that nothing scans for is a rule that
  # only holds where somebody happened to read it.
  case $'\n'"$(selected_files)"$'\n' in
    *$'\n'AGENTS-ai.md$'\n'*) printf 'ai-guard.mjs\n' ;;
  esac
}

# NOTE: this function's STDOUT is the manifest, so every message it prints must go to
# stderr. Measured 2026-09-28: a `kept ... not one of ours` warning landed in
# .agents/ecosystem/MANAGED as if it were a path, which both hid the warning from the
# human and would have made the workflow `git add` a sentence.
sync_scripts() {                  # sync_scripts <force> <changed> -> MANAGED-able paths to stdout
  local force="$1" changed="${2:-1}" name dest tmp
  mkdir -p "$SCRIPTS_DIR"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    dest="$SCRIPTS_DIR/$name"
    if [ -e "$dest" ] && [ "$force" != "1" ] && ! grep -qF "$MANAGED_BANNER" "$dest"; then
      note "kept $dest — it is not one of ours. Re-run with --force-scripts to replace it." >&2
      continue
    fi
    # Reuse one of ours already on disk when the source has not moved; still list it so
    # MANAGED stays complete. --force-scripts always re-fetches. A missing script falls
    # through to the fetch below regardless of the gate.
    if [ "$force" != "1" ] && [ "$changed" = "0" ] && [ -e "$dest" ] && grep -qF "$MANAGED_BANNER" "$dest"; then
      printf '%s\n' "$dest"; continue
    fi
    tmp="$(mktemp)"
    fetch "templates/$SCRIPTS_DIR/$name" > "$tmp"
    [ -s "$tmp" ] || die "fetched templates/$SCRIPTS_DIR/$name but it is empty"
    mv "$tmp" "$dest"; chmod 755 "$dest"
    printf '%s\n' "$dest"
  done < <(scripts_for_repo)

  # A vendored guard that nothing invokes is a scanner that prints nothing: 41 repos
  # vendored ui-guard.mjs and 10 ran it. This sync does not edit package.json -- the
  # scripts that need gating are named differently in every repo, and rewriting a
  # repo's own manifest is a bigger power than refreshing a briefing. So say, by name,
  # that the deploy gate is still missing. The check itself still RUNS on every PR,
  # from the agents-sync workflow's own step.
  if [ -f "$SCRIPTS_DIR/check-d1-not-inherited.mjs" ] && [ -f package.json ]; then
    if ! grep -qF 'check-d1-not-inherited.mjs' package.json; then
      note "scripts/check-d1-not-inherited.mjs is installed but no package.json script invokes it." >&2
      note "  agents-sync runs it on every PR; a deploy from a laptop is still ungated. Add:" >&2
      note '    "check:d1": "node scripts/check-d1-not-inherited.mjs",' >&2
      note "  and prefix deploy / deploy:preview / migrate:remote with it." >&2
    fi
  fi

  # tokens.mjs is NOT vendored here. Its one source is ~/bin/tokens_cli/sdk/tokens.mjs,
  # and a copy in this repo would be a second copy to keep in step — which AGENTS.md
  # names as the mistake. Scaffold it from the CLI when the CLI is here; a CI runner has
  # no tokens CLI and no secrets to reach anyway, so it simply skips.
  if command -v tokens >/dev/null 2>&1; then
    if [ ! -e "$SCRIPTS_DIR/tokens.mjs" ] || grep -qF "requireSecret" "$SCRIPTS_DIR/tokens.mjs" 2>/dev/null; then
      if tokens agent-onboarding --scaffold-mjs "$SCRIPTS_DIR/tokens.mjs" >/dev/null 2>&1; then
        printf '%s\n' "$SCRIPTS_DIR/tokens.mjs"
      else
        note "could not scaffold $SCRIPTS_DIR/tokens.mjs — run: tokens agent-onboarding --scaffold-mjs $SCRIPTS_DIR/tokens.mjs" >&2
      fi
    fi
  fi
}

FORCE_SCRIPTS=0

cmd_sync() {
  local dry="${1:-}"
  detect
  local files; files="$(selected_files)"
  [ -n "$files" ] || die "detection selected nothing — that is a bug, not an empty repo"

  local blockfile; blockfile="$(mktemp)"; render_block > "$blockfile"

  if [ "$dry" = "--dry-run" ]; then
    cmd_list; printf '\nwould write %s/{%s}\nand this block into AGENTS.md:\n\n' \
      "$DEST_REL" "$(printf '%s' "$files" | paste -sd, -)"
    cat "$blockfile"; rm -f "$blockfile"; return 0
  fi

  # The change gate. One head-SHA probe decides whether the per-file DOWNLOADS below run.
  # When the source has not moved since this repo last synced, a briefing or script already
  # on disk is reused instead of re-fetched, so an unchanged colby-ecosystem costs ONE
  # request (this probe) instead of 8-14. Only network fetches are gated — the prune, the
  # MANAGED manifest, the package.json-wiring warning and the AGENTS.md block all still run
  # every time, so nothing is skipped except downloads that would return identical bytes.
  #
  # It fails OPEN: an empty probe (network, rate limit, an unknown ref) leaves
  # source_changed=1, so every file is fetched exactly as before. A missing file is fetched
  # regardless of the gate, so the gate can never leave a needed file absent.
  local sha_file="$DEST_REL/.synced-sha" head_sha prev_sha="" source_changed=1
  [ -f "$sha_file" ] && prev_sha="$(cat "$sha_file" 2>/dev/null || true)"
  head_sha="$(remote_head_sha 2>/dev/null || true)"
  [ -n "$head_sha" ] && [ "$head_sha" = "$prev_sha" ] && source_changed=0

  # Fetch into a staging directory first. `fetch f > dest` truncates dest BEFORE the
  # fetch can fail, so a token that cannot read the source used to leave a zero-byte
  # AGENTS.md behind — present, empty, and indistinguishable from a real one. Measured
  # 2026-09-28: a 51KB briefing became 0 bytes on the first failed call.
  mkdir -p "$DEST_REL"
  local stage; stage="$(mktemp -d)"
  local f n=0 fetched=0
  for f in $files; do
    n=$((n + 1))
    # Reuse a briefing already on disk when the source has not moved; always fetch a
    # missing one. Staging preserves the atomic-write guarantee for the files we fetch.
    if [ "$source_changed" = 0 ] && [ -f "$DEST_REL/$f" ]; then
      continue
    fi
    fetch "$f" > "$stage/$f"
    [ -s "$stage/$f" ] || die "fetched $f but it is empty — refusing to write a half-synced tree"
    fetched=$((fetched + 1))
  done
  for f in $files; do [ -f "$stage/$f" ] && mv "$stage/$f" "$DEST_REL/$f"; done
  rm -rf "$stage"

  # Prune what this repo no longer needs. A stale chapter is not harmless: the whole
  # point is that the set is right-sized, and a leftover 79KB Cloudflare chapter in a
  # Python repo is the failure this script exists to prevent.
  local existing
  for existing in "$DEST_REL"/AGENTS*.md; do
    [ -e "$existing" ] || continue
    case $'\n'"$files"$'\n' in
      *$'\n'"$(basename "$existing")"$'\n'*) ;;
      *) rm -f "$existing"; note "pruned $(basename "$existing") — this repo no longer matches it" ;;
    esac
  done
  # One version of the script for hooks and CI, versioned with the briefings it wrote.
  if [ -f "${BASH_SOURCE[0]}" ] && ! cmp -s "${BASH_SOURCE[0]}" "$DEST_REL/pull-agents"; then
    cp "${BASH_SOURCE[0]}" "$DEST_REL/pull-agents"; chmod 755 "$DEST_REL/pull-agents"
  fi
  printf 'Synced from %s@%s. Managed by .github/workflows/agents-sync.yml — edits here are overwritten.\n' \
    "$SOURCE_REPO" "$SOURCE_REF" > "$DEST_REL/README.md"

  # The scripts, and the manifest of everything this run owns. The workflow adds exactly
  # these paths: `git add -A scripts` would sweep in whatever else the repo keeps there.
  local managed; managed="$(sync_scripts "$FORCE_SCRIPTS" "$source_changed")"
  {
    printf '%s\n' "$DEST_REL" "AGENTS.md"
    printf '%s\n' "$managed"
  } | awk 'NF' | while IFS= read -r _p; do
    # Only real paths reach the manifest. The workflow feeds it straight to `git add`,
    # so one stray line there is a failed run in every repo at once.
    [ -e "$_p" ] && printf '%s\n' "$_p"
  done > "$DEST_REL/MANAGED"

  # Record the SHA just synced, so the next run's gate can compare against it. .agents/ is
  # committed by the workflow (git add -A -f .agents), so CI's next run reads this back.
  [ -n "$head_sha" ] && printf '%s\n' "$head_sha" > "$sha_file"

  write_block "$blockfile"; rm -f "$blockfile"
  note "synced $DEST_REL: $fetched briefing(s) fetched, $((n - fetched)) reused$(printf '%s' "$managed" | awk 'NF' | wc -l | awk '{printf "; %s script(s)", $1}')"
}

cmd_install_hooks() {
  local dir; dir="$(git rev-parse --git-path hooks)"
  mkdir -p "$dir"
  local h
  for h in post-merge post-checkout; do
    cat > "$dir/$h" <<'HOOK'
#!/usr/bin/env bash
# installed by pull-agents install-hooks — keeps .agents/ecosystem/ fresh locally.
# Fail-soft on purpose: no network, no gh, no token must never block a checkout.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -x "$root/.agents/ecosystem/pull-agents" ] || exit 0
QUIET=1 "$root/.agents/ecosystem/pull-agents" >/dev/null 2>&1 || true
HOOK
    chmod 755 "$dir/$h"
  done
  # pre-commit: reject staged workflows that hardcode a self-hosted runner. Unlike the two
  # hooks above this one BLOCKS -- but only on a real violation; a missing guard, python3,
  # or git error lets the commit through. A pre-commit hook that is not ours is kept and
  # run first (pre-commit.chained), never overwritten.
  local pc="$dir/pre-commit"
  if [ -e "$pc" ] && ! grep -qF "runner-guard" "$pc"; then mv "$pc" "$dir/pre-commit.chained"; fi
  cat > "$pc" <<'HOOK'
#!/usr/bin/env bash
# installed by pull-agents install-hooks — runner-guard: no hardcoded self-hosted runs-on.
d="$(dirname "$0")"
if [ -x "$d/pre-commit.chained" ]; then "$d/pre-commit.chained" "$@" || exit $?; fi
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
g="$root/scripts/runner-guard"; [ -f "$g" ] || g="$root/templates/scripts/runner-guard"
[ -f "$g" ] && command -v python3 >/dev/null 2>&1 || exit 0
python3 "$g" check --staged || { echo "runner-guard: commit blocked (bypass only with Justin's OK: git commit --no-verify)" >&2; exit 1; }
HOOK
  chmod 755 "$pc"
  note "installed post-merge, post-checkout and pre-commit (runner-guard) in $dir"
  note "hooks are not cloned: run this once per clone and per worktree"
}

for _arg in "$@"; do [ "$_arg" = "--force-scripts" ] && FORCE_SCRIPTS=1; done
set -- $(printf '%s\n' "$@" | grep -v '^--force-scripts$' || true)

case "${1:-sync}" in
  sync|"")        cmd_sync ;;
  --dry-run)      cmd_sync --dry-run ;;
  --list|list)    cmd_list ;;
  install-hooks)  cmd_install_hooks ;;
  -h|--help|help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)              die "unknown command: $1 (try: sync, --list, --dry-run, install-hooks)" ;;
esac
